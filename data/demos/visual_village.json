    "tavern": {
      "id": "tavern",
      "location": "Таверна",
      "title": "Таверна",
      "text": "В таверне шумно. Хозяйка Эла протирает кружки и бросает на вас быстрый взгляд.",
      "choices": [
        {
          "text": "Спросить, всё ли в порядке",
          "icon": "❓",
          "once": true,
          "showIf": {
            "all": [{ "notFlag": "missing_supplies_started" }]
          },
          "flags": { "missing_supplies_started": true },
          "questSet": { "questId": "missing_supplies", "stage": "0" },
          "to": "tavern_quest_started"
        },
        {
          "text": "Отдать найденные припасы",
          "icon": "📦",
          "once": true,
          "showIf": {
            "all": [
              { "questMinStage": { "questId": "missing_supplies", "stage": 2 } },
              { "hasItem": "village_supplies" }
            ]
          },
          "questSet": { "questId": "missing_supplies", "stage": "complete" },
          "to": "tavern_quest_done"
        },
        {
          "text": "Спросить о сундуке",
          "icon": "💬",
          "showIf": {
            "all": [
              { "questMinStage": { "questId": "missing_supplies", "stage": 0 } },
              { "notFlag": "village_chest_looted" }
            ]
          },
          "to": "tavern_hint_chest"
        },
        {
          "text": "Спросить о воре на дороге",
          "icon": "🗡️",
          "showIf": {
            "all": [
              { "questMinStage": { "questId": "missing_supplies", "stage": 1 } },
              { "notFlag": "village_bandit_cleared" }
            ]
          },
          "to": "tavern_hint_bandit"
        },
        {
          "text": "Выйти на площадь",
          "icon": "🚪",
          "to": "village"
        }
      ]
    },
    "tavern_quest_started": {
      "id": "tavern_quest_started",
      "location": "Таверна",
      "title": "Таверна",
      "text": "Эла вздыхает.\n\n«Пропали припасы — ящики у часовни. Если найдёшь сундук и вернёшь еду, я не останусь в долгу. Смотри: у дороги уже шатаются воры.»",
      "choices": [
        {
          "text": "Выйти на площадь",
          "icon": "🚪",
          "to": "village"
        }
      ]
    },
    "tavern_hint_chest": {
      "id": "tavern_hint_chest",
      "location": "Таверна",
      "title": "Таверна",
      "text": "«Ищите у часовни — старый сундук. Он должен быть на площади, если задание уже взяли.»",
      "choices": [
        { "text": "Вернуться к стойке", "to": "tavern" },
        { "text": "На площадь", "to": "village" }
      ]
    },
    "tavern_hint_bandit": {
      "id": "tavern_hint_bandit",
      "location": "Таверна",
      "title": "Таверна",
      "text": "«Вор на дороге не уйдёт сам. Разберись с ним — и припасы будут в безопасности.»",
      "choices": [
        { "text": "Вернуться к стойке", "to": "tavern" },
        { "text": "На площадь", "to": "village" }
      ]
    },
